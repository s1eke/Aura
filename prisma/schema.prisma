// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String
  password  String
  avatar    String?  // 用户头像
  
  // 用户的聊天气泡颜色设置
  myBubbleBackground    String?  @default("#95ec69") // 我的气泡背景色
  myBubbleBorder        String?  @default("transparent") // 我的气泡边框色
  myBubbleText          String?  @default("#000000") // 我的气泡文字色
  
  // 对方(AI/角色)的聊天气泡颜色设置
  otherBubbleBackground String?  @default("#ffffff") // 对方气泡背景色
  otherBubbleBorder     String?  @default("#e5e5e5") // 对方气泡边框色
  otherBubbleText       String?  @default("#000000") // 对方气泡文字色
  statusIcon            String?  // 用户状态图标

  // API Configuration
  apiBaseUrl    String?
  apiKey        String?
  llmModel      String?
  visionModel   String?
  momentMode    Boolean  @default(false) // 朋友圈模式：true=仅看动态(屏蔽评论点赞)，false=看全部
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  personas  Persona[]
  sessions  ChatSession[]
  messages  Message[]
  moments   Moment[]
  momentLikes MomentLike[]
  momentComments MomentComment[]
  notifications Notification[]
  sentNotifications Notification[] @relation("NotificationSourceUser")
}

model Persona {
  id           String   @id @default(cuid())
  name         String
  avatar       String?
  instruction  String   @default("") // 这里的 instruction 可以作为系统提示词的基础
  
  // 新增角色属性
  gender       String?  // 性别
  description  String?  // 人设设定 (详细描述)
  style        String?  // 表达风格
  catchphrases String?  // 习惯用语
  greeting     String?  // 开场白

  userId       String
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     ChatSession[]
  momentLikes  MomentLike[]
  momentComments MomentComment[]
  momentInteractions MomentInteraction[]
  sentNotifications Notification[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  personaId String
  
  // 聊天设置
  isPinned      Boolean  @default(false) // 置顶聊天
  isBlacklisted Boolean  @default(false) // 黑名单
  bgImage       String?  // 聊天背景图片URL（处理后的最终图片）
  bgMode        String   @default("cover") // 背景显示模式: cover(填充), stretch(拉伸), tile(平铺), center(居中)
  allowEmoji    Boolean  @default(true)  // 允许发送表情包
  allowNudge    Boolean  @default(true)  // 允许拍一拍
  allowAction   Boolean  @default(true)  // 允许动作描述
  allowActionDescription Boolean @default(true) // 允许AI输出中的动作描述（括号内容）
  maxReplies    Int      @default(5)     // 最多回复条数
  contextSize   Int      @default(10)    // 上下文消息数量 (10-20)
  memoryEnabled Boolean  @default(true)  // 记忆增强开关（默认开启）
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  messages  Message[]
  memories  SessionMemory[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String      @id @default(cuid())
  content   String
  role      String      // "user" or "assistant"
  sessionId String
  userId    String
  
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  imageUrl  String?     // 图片URL（如果消息包含图片）
  imageId   String?     // 关联到 Image 表
  image     Image?      @relation(fields: [imageId], references: [id])
  
  createdAt DateTime    @default(now())
  isDeleted Boolean     @default(false) // 软删除标记
  isBlocked Boolean     @default(false) // 是否被对方拉黑（消息发出但拒收）
}

model Image {
  id          String   @id @default(cuid())
  md5         String   @unique // MD5 哈希值，作为唯一标识
  filepath    String   // 相对路径，如 /uploads/2024/12/04/abc123.jpg
  filename    String   // 原始文件名
  mimetype    String   // 文件类型，如 image/jpeg
  size        Int      // 文件大小（字节）
  
  // 视觉模型描述（缓存）
  visionDescription String? // 视觉模型的描述
  visionModelName   String? // 使用的视觉模型名称
  visionAnalyzedAt  DateTime? // 分析时间
  
  uploadedBy  String   // 上传用户 ID
  createdAt   DateTime @default(now())
  
  messages    Message[] // 关联的消息
  momentImages MomentImage[] // 关联的动态图片
  
  @@index([md5])
  @@index([uploadedBy])
}

// 动态(朋友圈)模型
model Moment {
  id          String   @id @default(cuid())
  content     String   // 文本内容
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  images      MomentImage[]
  likes       MomentLike[]
  comments    MomentComment[]
  interactions MomentInteraction[] // 追踪哪些角色已经看过/反应过
  notifications Notification[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([createdAt])
}

model MomentImage {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  
  imageId   String
  image     Image    @relation(fields: [imageId], references: [id])
  
  order     Int      @default(0) // 显示顺序
  
  @@index([momentId])
}

model MomentLike {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  
  userId    String?  // 用户点赞（与personaId互斥）
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  personaId String?  // AI角色点赞（与userId互斥）
  persona   Persona? @relation(fields: [personaId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([momentId, userId])
  @@unique([momentId, personaId])
  @@index([momentId])
}

model MomentComment {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  content   String
  
  userId    String?  // 用户评论（与personaId互斥）
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  personaId String?  // AI角色评论（与userId互斥）
  persona   Persona? @relation(fields: [personaId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([momentId])
}

model MomentInteraction {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  
  // 追踪角色是否已经处理过这条动态
  hasReacted Boolean @default(false)
  reactedAt  DateTime?
  
  createdAt DateTime @default(now())
  
  @@unique([momentId, personaId])
  @@index([personaId])
  @@index([momentId])
}

model SessionMemory {
  id           String      @id @default(cuid())
  sessionId    String
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  content      String // 记忆总结内容
  messageCount Int    // 总结了多少条消息
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  @@index([sessionId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // 接收通知的用户
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // LIKE, COMMENT, SYSTEM
  content   String?  // 通知内容（如评论内容）
  
  // 触发通知的来源（用户或角色）
  sourceUserId String?
  sourceUser   User?   @relation("NotificationSourceUser", fields: [sourceUserId], references: [id])
  
  sourcePersonaId String?
  sourcePersona   Persona? @relation(fields: [sourcePersonaId], references: [id])
  
  // 关联的动态
  momentId  String?
  moment    Moment?  @relation(fields: [momentId], references: [id], onDelete: Cascade)
  
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
